<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="240.0" prefWidth="200.0" spacing="12.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.findlayt.calculator.ui.CalculatorController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <Label fx:id="display" alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308" style="-fx-font-size: 32px; -fx-font-family: monospace;" text="0" />

    <GridPane hgap="8.0" vgap="8.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="25" />
            <ColumnConstraints percentWidth="25" />
            <ColumnConstraints percentWidth="25" />
            <ColumnConstraints percentWidth="25" />
        </columnConstraints>

        <Button maxWidth="1.7976931348623157E308" onAction="#onClearClick" text="C" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Button maxWidth="1.7976931348623157E308" onAction="#onDigitClick" text="7" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <Button maxWidth="1.7976931348623157E308" onAction="#onDigitClick" text="8" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Button maxWidth="1.7976931348623157E308" onAction="#onDigitClick" text="9" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <Button maxWidth="1.7976931348623157E300" onAction="#onOperatorClick" text="÷" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Button maxWidth="1.7976931348623157E308" onAction="#onDigitClick" text="4" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <Button maxWidth="1.7976931348623157E308" onAction="#onDigitClick" text="5" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Button maxWidth="1.7976931348623157E308" onAction="#onDigitClick" text="6" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <Button maxWidth="1.7976931348623157E308" onAction="#onOperatorClick" text="×" GridPane.columnIndex="3" GridPane.rowIndex="2" />

        <Button maxWidth="1.7976931348623157E308" onAction="#onDigitClick" text="1" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <Button maxWidth="1.7976931348623157E308" onAction="#onDigitClick" text="2" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        <Button maxWidth="1.7976931348623157E308" onAction="#onDigitClick" text="3" GridPane.columnIndex="2" GridPane.rowIndex="3" />
        <Button maxWidth="1.7976931348623157E308" onAction="#onOperatorClick" text="−" GridPane.columnIndex="3" GridPane.rowIndex="3" />

        <Button maxWidth="1.7976931348623157E308" onAction="#onDigitClick" text="0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4" />
        <Button maxWidth="1.7976931348623157E308" onAction="#onOperatorClick" text="." GridPane.columnIndex="2" GridPane.rowIndex="4" />
        <Button maxWidth="1.7976931348623157E308" onAction="#onOperatorClick" text="+" GridPane.columnIndex="3" GridPane.rowIndex="4" />

        <Button maxWidth="1.7976931348623157E308" onAction="#onEqualsClick" text="=" GridPane.columnIndex="3" GridPane.rowIndex="0" />
      <rowConstraints>
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>
    </GridPane>
</VBox>
